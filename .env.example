# Copie ce fichier en `.env` et remplis les valeurs. Ne commite jamais `.env`.
# Les deux sections ci-dessous servent l'une en production (docker-compose.yml), l'autre en développement.

# =====================================================================
# Production (docker-compose.yml, sur le VPS)
# =====================================================================

# --- Application -----------------------------------------------------

# Base PostgreSQL du conteneur `db`. Mot de passe sans caractères spéciaux (il est inséré dans une URL) :
# `openssl rand -hex 24`
POSTGRES_USER=porolympiques
POSTGRES_PASSWORD=
POSTGRES_DB=porolympiques

# Secret de signature des sessions, 32 caractères minimum : `openssl rand -hex 32`
JWT_SECRET=

# URL publique du site, sans slash final. Sert aussi à construire l'URL de retour OAuth.
APP_URL=https://porolympiques.tongcho7.com

# Dossier des données PostgreSQL sur l'hôte (chemin absolu). Sans cette variable : volume Docker nommé.
DB_DATA_DIR=

# Nom du réseau Docker partagé avec Caddy (le même que pour kanadrill).
PROXY_NETWORK=

# --- Discord ----------------------------------------------------------
# Portail : https://discord.com/developers/applications

# OAuth2 → Client ID / Client Secret. Redirect à déclarer : ${APP_URL}/api/auth/discord/callback
# (DISCORD_REDIRECT_URI est construit par docker-compose.yml à partir de APP_URL : inutile ici.)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot → Token (intent privilégié « Server Members » activé).
DISCORD_BOT_TOKEN=
# Identifiant du serveur (clic droit sur le serveur → Copier l'identifiant, en mode développeur).
DISCORD_GUILD_ID=
# Identifiants Discord des admins, séparés par des virgules (au moins un).
DISCORD_ADMIN_IDS=
# Identifiant du salon des annonces (phase 7, facultatif d'ici là).
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=

# --- IGDB (phase 4) ---------------------------------------------------
# Application Twitch : https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=


# =====================================================================
# Développement local (npm run dev:api)
# =====================================================================
# Pour développer, mets plutôt ceci dans ton `.env` (la base vient de docker-compose.dev.yml) :
#
# DATABASE_URL=postgres://porolympiques:devpass@127.0.0.1:5433/porolympiques
# JWT_SECRET=<32 caractères minimum>
# APP_URL=http://localhost:4200
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...
# DISCORD_REDIRECT_URI=http://localhost:4200/api/auth/discord/callback
# DISCORD_BOT_TOKEN=...
# DISCORD_GUILD_ID=...
# DISCORD_ADMIN_IDS=...
# DISCORD_ANNOUNCEMENTS_CHANNEL_ID=...
# TWITCH_CLIENT_ID=...
# TWITCH_CLIENT_SECRET=...
#
# Tests d'intégration (base créée par scripts/dev-db-init.sql) :
# TEST_DATABASE_URL=postgres://porolympiques:devpass@127.0.0.1:5433/porolympiques_test
