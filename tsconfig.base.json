{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": [
      "es2022",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@porolympiques/api": [
        "./libs/api/src/index.ts"
      ],
      "@porolympiques/bot": [
        "./libs/bot/src/index.ts"
      ],
      "@porolympiques/database": [
        "./libs/database/src/index.ts"
      ],
      "@porolympiques/domain": [
        "./libs/domain/src/index.ts"
      ],
      "@porolympiques/igdb": [
        "./libs/igdb/src/index.ts"
      ],
      "@porolympiques/shared": [
        "./libs/shared/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
